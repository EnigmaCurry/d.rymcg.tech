#!/bin/bash

## reconfigure_oauth2 ENV_FILE VAR_PREFIX
##
## Called from reconfigure_auth. Enables OAuth2 sentry auth on an app and
## prompts for the OIDC group name that will be allowed through.
##
## The authorization group's format is dictated by whatever your oauth2-proxy
## OIDC provider puts in the `groups` claim. For Forgejo (the default provider):
##   - a plain team name (e.g. `admins`) matches a team of that name in any org
##   - `<org>:<team>` matches a specific team scoped to an org
## For other providers (GitHub, GitLab, Keycloak, generic OIDC) the format
## varies — see the provider's docs for how it populates the OIDC `groups` claim.

BIN=$(dirname ${BASH_SOURCE})
source ${BIN}/funcs.sh
set -e

if [[ ${__D_RY_CONFIG_ENTRY} != reconfigure_auth ]]; then
    echo "\`${BASH_SOURCE}\` was designed to be called from \`reconfigure_auth\`."
    echo
    exit 1
fi

ENV_FILE=${1}
shift

VAR_PREFIX=${1}
shift

## Make new .env if it doesn't exist:
test -f ${ENV_FILE} || cp .env-dist ${ENV_FILE}

docker inspect oauth2-proxy >/dev/null || (echo "oauth2-proxy is not installed. Follow the directions at https://github.com/EnigmaCurry/d.rymcg.tech/tree/master/oauth2-proxy#readme and then retry this" && exit 1)

## Enable oauth2 for this app
${BIN}/reconfigure ${ENV_FILE} ${VAR_PREFIX}_OAUTH2=true
echo

## Prompt for the authorization group (freeform text — the exact format is
## whatever your OIDC provider puts in the `groups` claim).
${BIN}/reconfigure_ask ${ENV_FILE} ${VAR_PREFIX}_OAUTH2_AUTHORIZED_GROUP \
    "Enter the OIDC group name allowed to access this app (Forgejo team name, or <org>:<team>)"
