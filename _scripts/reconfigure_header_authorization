#!/bin/bash

## reconfigure_header_authorization ENV_FILE [CMD]
##
## Manages TRAEFIK_HEADER_AUTHORIZATION_GROUPS: a JSON map where each key is an
## "authorization group" (the name of a Traefik middleware named
## `header-authorization-group-<key>@file`) and each value is a list of Forgejo
## team/org names that are allowed through that middleware.
##
## Membership within Forgejo teams themselves is managed in Forgejo — not here.
## Adding/removing a user from a Forgejo team takes effect on their next request
## (once their oauth2-proxy session is refreshed) with no Traefik restart.
## Traefik only needs a restart when this env var changes (new group defined,
## or the list of allowed Forgejo teams for a group changes).

BIN=$(dirname ${BASH_SOURCE})
source ${BIN}/funcs.sh

ENV_FILE=../traefik/${1}
shift
## Make new .env if it doesn't exist:
test -f ${ENV_FILE} || cp ../traefik/.env-dist ${ENV_FILE}

get_groups_json() {
    local raw=$(${BIN}/dotenv -f ${ENV_FILE} get TRAEFIK_HEADER_AUTHORIZATION_GROUPS)
    if [[ -z "$raw" ]]; then
        echo "{}"
    else
        echo "$raw"
    fi
}

manage_groups() {
    set -eo pipefail
    local json=$(get_groups_json)
    readarray -t existing < <(echo "$json" | jq -r 'keys | .[]')
    local group
    group=$(eval "wizard choose 'Choose an authorization group to manage' -- ${existing[@]@Q} 'Create a new authorization group'")
    if [[ "$group" == "Create a new authorization group" ]]; then
        create_group
    else
        manage_group "$group"
    fi
}

manage_group() {
    set -eo pipefail
    local group=$1
    [[ -z "$group" ]] && return 1
    while :
    do
        set +e
        local task
        task=$(wizard choose -- "Managing '${group}' :: select a task ::" \
            "Add allowed Forgejo teams" \
            "Remove allowed Forgejo teams" \
            "List allowed Forgejo teams" \
            "Delete this authorization group")
        [[ "$?" != "0" ]] && return 1
        case "$task" in
            "Add allowed Forgejo teams")
                (add_allowed_teams "$group");;
            "Remove allowed Forgejo teams")
                (remove_allowed_teams "$group");;
            "List allowed Forgejo teams")
                list_allowed_teams "$group";;
            "Delete this authorization group")
                wizard confirm "Really delete '${group}'?" no && delete_group "$group" && break;;
        esac
    done
}

list_allowed_teams() {
    set -eo pipefail
    local group=$1
    local json=$(get_groups_json)
    echo
    echo "$json" | jq -r ".\"${group}\"[]"
    echo
}

add_allowed_teams() {
    set -eo pipefail
    local group=$1
    local json=$(get_groups_json)
    readarray -t teams < <(echo "$json" | jq -r ".\"${group}\"[]")
    echo "Enter Forgejo team/org name(s) to allow, one per line."
    echo "(Membership within each team is managed in Forgejo, not here.)"
    while :
    do
        local team
        team=$(wizard ask 'Team name (press Esc or blank to finish)' --allow-blank)
        [[ -z "$team" ]] && break
        teams+=("$team")
    done
    local teams_json
    teams_json=$(jq -c -n '$ARGS.positional | unique' --args -- "${teams[@]}")
    json=$(echo "$json" | jq -c "(.\"${group}\" = ${teams_json})")
    ${BIN}/dotenv -f ${ENV_FILE} set TRAEFIK_HEADER_AUTHORIZATION_GROUPS="$json"
    echo "Updated TRAEFIK_HEADER_AUTHORIZATION_GROUPS in ${ENV_FILE}."
}

remove_allowed_teams() {
    set -eo pipefail
    local group=$1
    [[ -z "$group" ]] && return 1
    local json=$(get_groups_json)
    readarray -t existing < <(echo "$json" | jq -r ".\"${group}\"[]")
    if [[ ${#existing[@]} -eq 0 ]]; then
        echo "No allowed teams to remove."
        return 0
    fi
    local existing_json="${existing[@]@Q}"
    existing_json=$(jq -c -n '$ARGS.positional' --args ${existing_json})
    local kept
    kept=$(eval wizard select "'Managing ${group} :: unselect teams to remove ::'" --default "'${existing_json}'" --json -- ${existing[@]})
    json=$(echo "$json" | jq -c "(.\"${group}\" = ${kept})")
    ${BIN}/dotenv -f ${ENV_FILE} set TRAEFIK_HEADER_AUTHORIZATION_GROUPS="$json"
    echo "Updated TRAEFIK_HEADER_AUTHORIZATION_GROUPS in ${ENV_FILE}."
}

list_groups() {
    set -eo pipefail
    local json=$(get_groups_json)
    if [[ "$json" == "{}" ]]; then
        echo "No authorization groups have been defined yet."
        return 0
    fi
    echo "Current authorization groups (middleware name → allowed Forgejo teams):"
    echo
    echo "$json" | jq -C . | sed 's/^/    /'
}

create_group() {
    set -eo pipefail
    local group
    while true; do
        group=$(wizard ask "Enter the authorization group name (letters, digits, underscores only; used as the Traefik middleware suffix):")
        if [[ "$group" =~ ^[a-zA-Z0-9_]+$ ]]; then
            break
        fi
        echo "Invalid name. Use only letters, digits, or underscores."
        echo
    done
    local json=$(get_groups_json)
    local idx=$(echo "$json" | jq -c "keys | index(\"${group}\")")
    if [[ "$idx" != "null" ]]; then
        echo "Authorization group '${group}' already exists."
        return 0
    fi
    local teams=()
    if wizard confirm "Add allowed Forgejo teams to '${group}' now?" no; then
        echo "Enter Forgejo team/org name(s), one per line."
        while :
        do
            local team
            team=$(wizard ask "Team name (press Esc or blank to finish)" --allow-blank)
            [[ -z "$team" ]] && break
            teams+=("$team")
        done
    fi
    local teams_json
    teams_json=$(jq -c -n '$ARGS.positional | unique' --args -- "${teams[@]}")
    json=$(echo "$json" | jq -c "(.\"${group}\" = ${teams_json})")
    ${BIN}/dotenv -f ${ENV_FILE} set TRAEFIK_HEADER_AUTHORIZATION_GROUPS="$json"
    echo "Wrote new TRAEFIK_HEADER_AUTHORIZATION_GROUPS to ${ENV_FILE}."
}

delete_group() {
    set -eo pipefail
    local group=$1
    [[ -z "$group" ]] && return 1
    local json=$(get_groups_json)
    json=$(echo "$json" | jq -c "del(.\"${group}\")")
    ${BIN}/dotenv -f ${ENV_FILE} set TRAEFIK_HEADER_AUTHORIZATION_GROUPS="$json"
    echo "Deleted authorization group '${group}'."
}

check_does_traefik_need_restart() {
    local NEW=$(${BIN}/dotenv -f ${ENV_FILE} get TRAEFIK_HEADER_AUTHORIZATION_GROUPS)
    local RUNNING=$(docker inspect traefik-traefik-1 2>/dev/null | jq -r '.[0].Config.Labels."TRAEFIK_HEADER_AUTHORIZATION_GROUPS"')
    if [[ "$RUNNING" != "$NEW" ]]; then
        if ${BIN}/confirm no "Config change detected. Restart Traefik now" "?"; then
            make install
        else
            echo 'Remember to `make install` in traefik/ for these changes to take effect.'
            echo '(Adding/removing users within a Forgejo team does NOT require this —'
            echo ' only changes to group definitions here do.)'
        fi
    fi
}

list_callback_urls() {
    set -eo pipefail
    readarray -t projects < <(docker compose ls -q)
    local DOCKER_CONTEXT=$(docker context ls --format "{{.Current}} {{.Name}}" | grep -oP "^true \K.*")
    local ROOT_ENV_FILE=${DRT_ENV_DIR:-${ROOT_DIR}}/.env_${DOCKER_CONTEXT}
    https_port=$(${BIN}/dotenv -f ${ROOT_ENV_FILE} get PUBLIC_HTTPS_PORT)
    if [[ -z "$https_port" ]]; then
        fault "Could not get PUBLIC_HTTPS_PORT from root .env file"
    fi
    domains=()
    echo "## OAuth2 callback URLs for all deployed apps:"
    echo "## If you installed oauth2-proxy in AUTH HOST mode (default) you don't need these."
    echo "## Otherwise, copy/paste them into your Forgejo OAuth2 app's Redirect URIs."
    echo ""
    for project in ${projects[@]}; do
        readarray -t services < <(docker compose -p "$project" ps --services -q)
        for service in ${services[@]}; do
            env_file=$(docker inspect "${service}" | jq -r '.[0].Config.Labels["com.docker.compose.project.environment_file"]')
            if [[ -n "${env_file}" ]] && [[ "${env_file}" != "null" ]] && [[ -f "${env_file}" ]]; then
                traefik_host=$(grep -E "^.*_TRAEFIK_HOST" "${env_file}" | head -1 | cut -d '=' -f 2)
                if [[ -n "${traefik_host}" ]]; then
                    domains+=("${traefik_host}")
                fi
            fi
        done
    done
    IFS=$'\n' domains=($(sort <<<"${domains[*]}" | uniq)); unset IFS;
    for domain in ${domains[@]}; do
        if [[ "${https_port}" == "443" ]]; then
            echo "https://${domain}/oauth2/callback"
        else
            echo "https://${domain}:${https_port}/oauth2/callback"
        fi
    done
    echo ""
}

## check if oauth2-proxy is installed:
echo
if ! docker inspect oauth2-proxy >/dev/null; then
    echo "You must install oauth2-proxy (and forgejo) first before configuring the authorization middleware"
    echo "See https://github.com/EnigmaCurry/d.rymcg.tech/tree/master/oauth2-proxy#readme"
    echo "See https://github.com/EnigmaCurry/d.rymcg.tech/tree/master/forgejo#readme"
    exit 0
fi

CMD=$1; shift;
if [[ -z "$CMD" ]]; then
    while :
    do
        echo ""
        set +e
        TASK=$(wizard choose "Sentry Authorization Manager (main menu):" \
            "Manage authorization groups" \
            "List all authorization groups" \
            "List authorized callback URLs" \
            "Quit")
        if [[ $? != 0 ]]; then
            check_does_traefik_need_restart
            exit 0
        fi
        case "${TASK}" in
            "Manage authorization groups")
                (manage_groups);;
            "List all authorization groups")
                (list_groups);;
            "List authorized callback URLs")
                (list_callback_urls || fault "Error");;
            "Quit")
                check_does_traefik_need_restart
                exit 0;;
        esac
    done
else
    case "${CMD}" in
        "list-callback-urls")
            (list_callback_urls || fault "Error");;
        *)
            fault "Invalid command";;
    esac
fi
