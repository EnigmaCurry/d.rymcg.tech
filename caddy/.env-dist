CADDY_IMAGE=caddy:2
CADDY_INSTANCE=
# You can protect this instance from uninstallation by setting this true:
## If true, make this instance immune to: `make uninstall`, `make destroy`
## Still allowed regardless: `make install`, `make stop`, `make start`, `make restart`
CADDY_INSTANCE_PROTECTION=false

CADDY_TRAEFIK_HOST=caddy.example.com

# TLS mode:
##  traefik     - (default) Traefik terminates TLS, Caddy serves plain HTTP.
##                All Traefik middlewares (auth, mTLS, etc.) are available.
##  passthrough - (experimental) Traefik passes the raw TLS stream to Caddy,
##                and Caddy gets its own certificate via ACME (CADDY_ACME_CA).
##                Only CADDY_IP_SOURCERANGE applies; auth/mTLS settings are ignored.
CADDY_TLS_MODE=traefik

# Filter access by IP address source range (CIDR):
##Disallow all access: 0.0.0.0/32
##Allow all access: 0.0.0.0/0
CADDY_IP_SOURCERANGE=0.0.0.0/0

# ACME server for Caddy's own certificate (passthrough mode only):
CADDY_ACME_CA=acme-v02.api.letsencrypt.org

# HTTP Basic Authentication (traefik mode only):
# Use `make config` to fill this in properly, or set this to blank to disable.
CADDY_HTTP_AUTH=

# OAUTH2 (traefik mode only):
# Set to `true` to use OpenID/OAuth2 authentication via the
# traefik-forward-auth service in d.rymcg.tech.
CADDY_OAUTH2=false
# Restrict login to an authorization group (created via `make groups` in traefik):
CADDY_OAUTH2_AUTHORIZED_GROUP=

# Mutual TLS (mTLS) (traefik mode only):
# Set true or false. If true, all clients must present a certificate signed by Step-CA:
CADDY_MTLS_AUTH=false
# Enter a comma separated list of client domains allowed to connect via mTLS.
# Wildcards are allowed and encouraged on a per-app basis:
CADDY_MTLS_AUTHORIZED_CERTS=*.clients.caddy.example.com

# META:
# PREFIX=CADDY
