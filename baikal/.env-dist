# The Baikal release to build into the image, e.g. 0.13.0 (a release version,
# not a Docker image tag): https://github.com/sabre-io/Baikal/releases
# ckulka/baikal publishes no image for 0.13.0, so the image is built from
# ./image. Rebuild after changing this with `make build` (or `make install
# BUILD=1`); a plain `make install` reuses the existing image.
# Note: older .env-dist files used this variable for an image tag such as
# 0.10.1-nginx; change it to a release version.
BAIKAL_VERSION=0.13.0

# The PHP version to build the image with. Baikal 0.13.0 needs >= 8.2
# (0.11.0 dropped 8.1). 8.2's security fixes end 2026-12-31, so the default
# is 8.6 (supported through 2030-12-31). If 8.6 gives you trouble, set 8.5
# here as a fallback, then rebuild with `make build`.
BAIKAL_PHP_VERSION=8.6

# Bake the Home Assistant CalDAV fix into the image (see image/README.md).
# Leave it true unless you have a CalDAV client that breaks with the fix.
BAIKAL_HOME_ASSISTANT_FIX=true

BAIKAL_TRAEFIK_HOST=cal.example.com

# The Traefik entrypoint to use:
BAIKAL_TRAEFIK_ENTRYPOINT=websecure
BAIKAL_INSTANCE=
# You can protect this instance from uninstallation by setting this true:
## If true, make this instance immune to: `make uninstall`, `make destroy`
## Still allowed regardless: `make install`, `make stop`, `make start`, `make restart`
BAIKAL_INSTANCE_PROTECTION=false

# Filter access by IP address source range (CIDR):
##Disallow all access: 0.0.0.0/32
##Allow all access: 0.0.0.0/0
BAIKAL_IP_SOURCERANGE=0.0.0.0/0

BAIKAL_HTTP_AUTH=
BAIKAL_IP_SOURCERANGE=0.0.0.0/0
BAIKAL_OAUTH2=false
BAIKAL_OAUTH2_AUTHORIZED_GROUP=

# Mutual TLS (mTLS):
# Set true or false. If true, all clients must present a certificate signed by Step-CA:
BAIKAL_MTLS_AUTH=false
# Enter a comma separated list of client domains allowed to connect via mTLS.
# Wildcards are allowed and encouraged on a per-app basis:
BAIKAL_MTLS_AUTHORIZED_CERTS=*.clients.baikal.example.com

# META:
# PREFIX=BAIKAL
