export TERM=${TERM:-xterm-256color}
alias ls="ls --color=auto"
alias emacs="mg"
[[ -f /usr/share/bash-completion/bash_completion ]] && . /usr/share/bash-completion/bash_completion
if [[ -n "${DRT_ENV_DIR:-}" ]]; then
    _DRT_SHA_TAG="|BIND"
else
    _DRT_SHA_TAG="${DRT_GIT_SHA:+|${DRT_GIT_SHA:0:7}}"
fi
PS1="\n\[\033[1;34m\][d.rymcg.tech|\[\033[1;33m\]${DRT_CONTEXT}\[\033[0;36m\]${_DRT_SHA_TAG}\[\033[1;34m\]]\[\033[0m\] \[\033[1;33m\]\w\[\033[0m\]\n\$ "
eval "$(d.rymcg.tech completion bash)"
__d.rymcg.tech_cli_alias d
[ -n "${DRT_CONTEXT}" ] && [[ "${DOCKER:-}" != "false" ]] && type __d.rymcg.tech_context_alias &>/dev/null && __d.rymcg.tech_context_alias "${DRT_CONTEXT}" 2>/dev/null || true

## Display MOTD if present
_display_motd() {
    local data
    if [[ -s "${HOME}/.motd" ]]; then
        cat "${HOME}/.motd"
    elif [[ -n "${MOTD:-}" ]]; then
        data=$(echo "${MOTD}" | base64 -d 2>/dev/null) || return 0
        # Detect gzip magic bytes (\x1f\x8b) and decompress if needed
        if [[ $(echo "${data}" | head -c2 | xxd -p) == "1f8b" ]]; then
            echo "${MOTD}" | base64 -d | gunzip 2>/dev/null || true
        else
            echo "${data}"
        fi
    else
        cat <<'MOTD'
 ____     ____  _  _  __  __  ___  ___      ____  ____  ___  _   _
(  _ \   (  _ \( \/ )(  \/  )/ __)/ __)    (_  _)( ___)/ __)( )_( )
 )(_) )   )   / \  /  )    (( (__( (_-.      )(   )__)( (__  ) _ (
(____/ . (_)\_) (__) (_/\/\_)\___)\___/  .  (__) (____)\___)(_) (_)
===================================================================
  https://github.com/EnigmaCurry/d.rymcg.tech

  Read WORKSTATION_CONTAINER.md for full documentation.

  Quick tips:
    motd              Edit this message (persisted in your SOPS config)
    ~/.bashrc.local   Custom shell aliases, functions, env vars
    ~/.config/d.rymcg.tech/startup.sh   Runs once per container session

  On exit, these configs are automatically saved to your SOPS config:
    ~/.config/d.rymcg.tech/  ~/.config/doctl/     ~/.aws/
    ~/.config/gh/            ~/.config/rclone/    ~/.mc/
    ~/.config/wireguard/     ~/.gnupg/            ~/.ssh/
    ~/.kube/                 ~/.bashrc.local
===================================================================
MOTD
    fi
}
if _motd_text=$(_display_motd); then
    echo ""
    echo "${_motd_text}"
    echo ""
fi
unset _motd_text

## Edit the MOTD (message of the day) with $EDITOR
motd() {
    if [[ "${SOPS_SAVE_ON_EXIT:-}" != "true" || -z "${SOPS_CONFIG_FILE:-}" ]]; then
        echo "Error: Running in a stateless context, cannot save MOTD." >&2
        echo "Use 'drt' with a SOPS config to persist the MOTD," >&2
        echo "or set the MOTD env var (base64-encoded)." >&2
        return 1
    fi
    touch "${HOME}/.motd"
    ${EDITOR:-vi} "${HOME}/.motd"
}

## Save-on-exit: capture initial config state and diff on shell exit.
## Skipped inside a drt device (drt-device owns saving there).
if [[ "${SOPS_SAVE_ON_EXIT:-}" == "true" && -n "${SOPS_CONFIG_FILE:-}" && "${DRT_DEVICE:-}" != "true" ]]; then
    source /usr/local/lib/drt/drt-save.sh
    _sops_save_dir=$(mktemp -d)
    drt_save_snapshot "${_sops_save_dir}"

    _sops_save_on_exit() {
        if drt_save_diff "${_sops_save_dir}" > "${_sops_save_dir}/diff"; then
            echo "" >&2
            echo "## Configuration changes detected:" >&2
            cat "${_sops_save_dir}/diff" >&2
            echo "" >&2
            read -rp "Save changes to ${_SOPS_BIND_PATH:-${SOPS_CONFIG_FILE}}? [Y/n] " answer
            if [[ ! "${answer}" =~ ^[Nn]$ ]]; then
                while true; do
                    if drt_save_commit "${_sops_save_dir}"; then
                        echo "## Changes saved to ${_SOPS_BIND_PATH:-${SOPS_CONFIG_FILE}}" >&2
                        break
                    fi
                    if [[ ! -p "${_SOPS_SAVE_REQUEST:-}" ]]; then
                        echo "ERROR: Failed to encrypt changes" >&2
                        break
                    fi
                    echo "" >&2
                    echo "ERROR: Failed to save (wrong PIN, key not found, etc.)" >&2
                    read -rp "Retry? [Y/n] " _retry
                    if [[ "${_retry}" =~ ^[Nn]$ ]]; then
                        echo "## Changes NOT saved — unsaved config left in container at ${SOPS_CONFIG_FILE}" >&2
                        break
                    fi
                done
            else
                echo "## Changes discarded" >&2
            fi
        fi
        [[ -p "${_SOPS_SAVE_REQUEST:-}" ]] && echo "quit" > "${_SOPS_SAVE_REQUEST}"
        rm -rf "${_sops_save_dir}"
    }

    trap _sops_save_on_exit EXIT
fi

## Run startup script once per container session
_drt_startup_script="${HOME}/.config/d.rymcg.tech/startup.sh"
if [[ -r "${_drt_startup_script}" && ! -f /tmp/.drt-startup-done ]]; then
    touch /tmp/.drt-startup-done
    echo "## Running startup.sh ..." >&2
    source "${_drt_startup_script}"
fi
unset _drt_startup_script

## Source user-local customizations if present
[[ -r "${HOME}/.bashrc.local" ]] && source "${HOME}/.bashrc.local"
