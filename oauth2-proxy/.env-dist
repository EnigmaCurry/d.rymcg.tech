OAUTH2_PROXY_REPO=https://github.com/oauth2-proxy/oauth2-proxy
OAUTH2_PROXY_VERSION=v7.15.4

# You can protect this instance from uninstallation by setting this true:
## If true, make this instance immune to: `make uninstall`, `make destroy`
## Still allowed regardless: `make install`, `make stop`, `make start`, `make restart`
OAUTH2_PROXY_INSTANCE_PROTECTION=false


## Cookie encryption secret: CHANGE THIS
## Must be exactly 16, 24, or 32 bytes (base64 encoded).
## Generate: openssl rand -base64 32 | tr -d '\n' | head -c 44
OAUTH2_PROXY_COOKIE_SECRET=

OAUTH2_PROXY_LOG_LEVEL=info

## Auth host for this Docker server (must resolve publicly; a Traefik cert must exist for it):
OAUTH2_PROXY_HOST=auth.example.com
## Public port suffix used when constructing OAUTH2_PROXY_REDIRECT_URL and
## other URLs. MUST be empty for the default HTTPS port (443), or a leading
## colon plus the port number for anything else (e.g. ":7331"). The value
## is concatenated directly onto the host, so a bare integer produces
## "auth.example.com7331" (broken). `configure_https_port.sh` (run by
## `make config`) writes this in the correct form from top-level
## PUBLIC_HTTPS_PORT — prefer that over hand-editing this line.
### OAUTH2_PROXY_HTTPS_PORT=:7331
OAUTH2_PROXY_HTTPS_PORT=

## Comma-separated Traefik entrypoints that oauth2-proxy's public router
## should bind to. Must include every entrypoint from which the browser
## will reach ${OAUTH2_PROXY_HOST}/oauth2/*. Default is "websecure" (:443).
## If you serve apps on a custom entrypoint that IS publicly reachable
## (e.g. "rpgvox" on :7331) and "websecure" is NOT publicly reachable,
## set this to that custom entrypoint (or add it to the list) so the
## post-auth callback and /oauth2/start requests can actually complete.
OAUTH2_PROXY_ENTRYPOINTS=websecure

## Forgejo domain (upstream OIDC provider):
OAUTH2_PROXY_FORGEJO_DOMAIN=git.example.com

## Cookie scoped to the root domain so the session works across all subdomains on this server:
OAUTH2_PROXY_COOKIE_DOMAIN=example.com

## Domains oauth2-proxy will honor for the post-auth redirect (the `rd=`
## parameter passed to /oauth2/start). Prefix with `.` for a subdomain
## match. Default is subdomains on the default HTTPS port (443) only.
## To allow apps published on a custom Traefik entrypoint (e.g. :7331),
## append the `:*` variant so any port under the cookie domain is accepted:
### OAUTH2_PROXY_WHITELIST_DOMAINS=.${OAUTH2_PROXY_COOKIE_DOMAIN},.${OAUTH2_PROXY_COOKIE_DOMAIN}:*
OAUTH2_PROXY_WHITELIST_DOMAINS=.${OAUTH2_PROXY_COOKIE_DOMAIN}

## Cookie lifetime. Format: "12h", "168h", "30m", etc.
OAUTH2_PROXY_COOKIE_EXPIRE=12h

## Comma-separated CIDRs that oauth2-proxy trusts to send X-Forwarded-* headers.
## Traefik reaches oauth2-proxy exclusively via 127.0.0.1:4180 in this deployment
## (both the forward-auth middleware call and the public auth-domain router are
## pinned to the loopback-published port via loadbalancer.server.url), so loopback
## is the only source we need to trust.
OAUTH2_PROXY_TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

## Provider selection driver (used by config wizard; the actual runtime provider is OAUTH2_PROXY_PROVIDER below):
OAUTH2_PROXY_SELECTED_PROVIDER=forgejo

## OIDC provider config:
## PROVIDER=oidc uses OpenID Connect discovery: oauth2-proxy will fetch
## <OIDC_ISSUER_URL>/.well-known/openid-configuration to discover auth/token/userinfo endpoints.
## OIDC Discovery §4.3 requires this URL to match your provider's advertised `issuer`
## claim exactly (trailing slash matters). Forgejo has historically flipped between
## the two forms across releases, so verify with:
##   curl -s https://<forgejo-host>/.well-known/openid-configuration | jq .issuer
## and match this value byte-for-byte. If auth breaks with an "issuer did not match"
## error, that's the fix.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://git.example.com
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_SCOPE=openid email profile
## Allow any authenticated email through; group-level allow/deny is handled
## per-app via a Docker-labels-defined headauth middleware, not here.
OAUTH2_PROXY_EMAIL_DOMAINS=*

## Step-CA root certificates (only needed if your Forgejo/upstream uses a self-signed cert from Step-CA):
OAUTH2_PROXY_STEP_CA_ENABLED=false
OAUTH2_PROXY_STEP_CA_ENDPOINT=https://ca.example.com
OAUTH2_PROXY_STEP_CA_FINGERPRINT=
## Delete all other CAs that came from the alpine ca-certificates:
OAUTH2_PROXY_STEP_CA_ZERO_CERTS=false

# META:
# PREFIX=OAUTH2_PROXY
# INSTANTIABLE=false
