# The domain name for the pixel art MCP service:
COMFYUI_MCP_TRAEFIK_HOST=comfyui-mcp.example.com

# The HTTP path the MCP endpoint is served on. Clients connect to
# https://${COMFYUI_MCP_TRAEFIK_HOST}${COMFYUI_MCP_PATH}
COMFYUI_MCP_PATH=/mcp

# How this service reaches ComfyUI. The default talks to the ComfyUI
# container directly over the shared Docker network (see
# COMFYUI_MCP_COMFYUI_NETWORK), which avoids a round trip through Traefik.
# The hostname is the ComfyUI *compose service* name, which depends on which
# GPU profile ComfyUI runs under: comfyui-cuda, comfyui-rocm, comfyui-intel,
# or comfyui-cpu.
COMFYUI_MCP_COMFYUI_URL=http://comfyui-cuda:8188

# The external Docker network belonging to the ComfyUI project. This is
# normally {comfyui project dir}_default. Find it with: docker network ls
COMFYUI_MCP_COMFYUI_NETWORK=comfyui_default

# The SDXL checkpoint to generate with. Must already be installed in ComfyUI
# under models/checkpoints (use `make add-models` in the comfyui project).
COMFYUI_MCP_CHECKPOINT=albedobaseXL_v21.safetensors

# The pixel art LoRA, installed in ComfyUI under models/loras.
# https://huggingface.co/nerijs/pixel-art-xl
COMFYUI_MCP_LORA=pixel-art-xl.safetensors

# The resolution to render at before downscaling to the sprite grid.
# 1024 suits SDXL; lower values degrade quality rather than just going faster.
COMFYUI_MCP_BASE_RESOLUTION=1024

# How long to wait for a single generation before giving up (seconds):
COMFYUI_MCP_JOB_TIMEOUT=600

# How many past jobs (and their images) to retain on disk:
COMFYUI_MCP_MAX_HISTORY=200

## Configure an API token required to access the MCP endpoint:
## Leave blank to disable the token requirement.
## Clients send it as:  Authorization: Bearer ${COMFYUI_MCP_API_TOKEN}
COMFYUI_MCP_API_TOKEN=

# Log level for the MCP server (critical, error, warning, info, debug, trace):
COMFYUI_MCP_LOG_LEVEL=info

# DNS rebinding protection. Leave blank to accept any Host header (correct
# when Traefik is the only way in). If set to a comma separated list of
# hostnames, requests with any other Host header are rejected.
COMFYUI_MCP_ALLOWED_HOSTS=

# The name of this instance. If there is only one instance, use 'default'.
COMFYUI_MCP_INSTANCE=
# You can protect this instance from uninstallation by setting this true:
## If true, make this instance immune to: `make uninstall`, `make destroy`
## Still allowed regardless: `make install`, `make stop`, `make start`, `make restart`
COMFYUI_MCP_INSTANCE_PROTECTION=false

# Filter access by IP address source range (CIDR):
##Disallow all access: 0.0.0.0/32
##Allow all access: 0.0.0.0/0
COMFYUI_MCP_IP_SOURCERANGE=0.0.0.0/0

# HTTP Basic Authentication:
# Use `make config` to fill this in properly, or set this to blank to disable.
COMFYUI_MCP_HTTP_AUTH=

# OAUTH2
# Set to `true` to use OpenID/OAuth2 authentication via the
# traefik-forward-auth service in d.rymcg.tech.
# Note that MCP clients are not browsers and generally cannot complete an
# interactive OAuth2 login redirect. Prefer HTTP Basic Auth or mTLS for this
# service unless your client is known to handle the redirect.
COMFYUI_MCP_OAUTH2=false
# In addition to Oauth2 authentication, you can configure basic authorization
# by entering which authorization group can log into your app. You create
# groups of email addresses in the `traefik` folder by running `make groups`.
COMFYUI_MCP_OAUTH2_AUTHORIZED_GROUP=

# Mutual TLS (mTLS):
# Set true or false. If true, all clients must present a certificate signed by Step-CA:
COMFYUI_MCP_MTLS_AUTH=false
# Enter a comma separated list of client domains allowed to connect via mTLS.
# Wildcards are allowed and encouraged on a per-app basis:
COMFYUI_MCP_MTLS_AUTHORIZED_CERTS=*.clients.comfyui-mcp.example.com

# META:
# PREFIX=COMFYUI_MCP
