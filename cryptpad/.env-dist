# The Docker image to use:
# https://hub.docker.com/r/cryptpad/cryptpad/tags
CRYPTPAD_IMAGE=cryptpad/cryptpad:version-2026.10.0

# CryptPad is designed to serve its content over two domains. Account
# passwords and cryptographic content is handled on the 'main' domain,
# while the user interface is loaded on a 'sandbox' domain which can only
# access information which the main domain willingly shares.
# Both domains are served by the same container (CryptPad tells them apart
# using the Host header and applies a restrictive Content-Security-Policy
# to the sandbox domain). A single wildcard TLS certificate covers both.
# NOTE: these are hostnames only; the instance is always served over HTTPS
# (port 443) by Traefik.
CRYPTPAD_TRAEFIK_HOST=pad.example.com
CRYPTPAD_SANDBOX_HOST=pad-sandbox.example.com

# The name of this instance. If there is only one instance, use 'default'.
CRYPTPAD_INSTANCE=

# You can protect this instance from uninstallation by setting this true:
## If true, make this instance immune to: `make uninstall`, `make destroy`
## Still allowed regardless: `make install`, `make stop`, `make start`, `make restart`
CRYPTPAD_INSTANCE_PROTECTION=false

# Filter access by IP address source range (CIDR):
##Disallow all access: 0.0.0.0/32
##Allow all access: 0.0.0.0/0
CRYPTPAD_IP_SOURCERANGE=0.0.0.0/0

# HTTP Basic Authentication:
# Use `make config` to fill this in properly, or set this to blank to disable.
CRYPTPAD_HTTP_AUTH=

# OAUTH2
# Set to `true` to use OpenID/OAuth2 authentication via the
# traefik-forward-auth service in d.rymcg.tech.
# Using OpenID/OAuth2 will require login to access your app,
# but it will not affect what a successfully logged-in person can do in your
# app. If your app has built-in authentication and can check the user
# header that traefik-forward-auth sends, then your app can limit what the
# logged-in person can do in the app. But if your app can't check the user
# header, or if your app doesn't have built-in authentication at all, then
# any person with an account on your Forgejo server can log into your app and
# have full access.
CRYPTPAD_OAUTH2=false
# In addition to Oauth2 authentication, you can configure basic authorization
# by entering which authorization group can log into your app. You create
# groups of email addresses in the `traefik` folder by running `make groups`.
CRYPTPAD_OAUTH2_AUTHORIZED_GROUP=

# Mutual TLS (mTLS):
# Set true or false. If true, all clients must present a certificate signed by Step-CA:
CRYPTPAD_MTLS_AUTH=false
# Enter a comma separated list of client domains allowed to connect via mTLS.
# Wildcards are allowed and encouraged on a per-app basis:
CRYPTPAD_MTLS_AUTHORIZED_CERTS=*.clients.cryptpad.example.com

# Set to 'yes' to install the office editors (the Document, Sheet, and
# Presentation apps) on the first start of the container. Since CryptPad
# 2026.10.0 these are based on Euro-Office (a fork of OnlyOffice) and are
# installed by install-office.sh. This downloads ~2-4GB of files into the
# onlyoffice_dist volume. Euro-Office is not open source; by setting this
# to 'yes' you accept its license:
# https://github.com/Euro-Office/web-apps/blob/main/LICENSE.txt
CRYPTPAD_INSTALL_ONLYOFFICE=yes

# Enter your email if you want it displayed on the contact page for
# support purposes (can be changed later in the administration panel):
CRYPTPAD_ADMIN_EMAIL=admin@example.com

# Some CryptPad server configs (rendered into config.js):
## Default storage limit for new users (JS expression; 1000 * 1024 * 1024 is 1GB):
CRYPTPAD_DEFAULT_STORAGE_LIMIT=1000 * 1024 * 1024
## Max size of a single file upload (JS expression):
CRYPTPAD_MAX_UPLOAD_SIZE=100 * 1024 * 1024
## Block CryptPad's daily check-in to the CryptPad project's servers:
CRYPTPAD_BLOCK_DAILY_CHECK=true
## Log level: silly, verbose, debug, feedback, info, warn, error
CRYPTPAD_LOG_LEVEL=warn

# The timezone to use inside the container:
CRYPTPAD_TIMEZONE=UTC

## Labels to configure Homepage
## See https://github.com/EnigmaCurry/d.rymcg.tech/tree/master/homepage#homepage
CRYPTPAD_HOMEPAGE_LABELS_ENABLE=true
CRYPTPAD_HOMEPAGE_GROUP_CRYPTPAD=Productivity
CRYPTPAD_HOMEPAGE_NAME_CRYPTPAD=CryptPad
CRYPTPAD_HOMEPAGE_ICON_CRYPTPAD=cryptpad
CRYPTPAD_HOMEPAGE_DESCRIPTION_CRYPTPAD=
CRYPTPAD_HOMEPAGE_SHOW_STATS_CRYPTPAD=false

# META:
# PREFIX=CRYPTPAD
