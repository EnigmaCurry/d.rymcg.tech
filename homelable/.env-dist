# Docker images (pinned to release v3.6.0):
# https://github.com/Pouzor/homelable/releases
HOMELABLE_BACKEND_IMAGE=ghcr.io/pouzor/homelable-backend:3.6.0
HOMELABLE_FRONTEND_IMAGE=ghcr.io/pouzor/homelable-frontend:3.6.0
HOMELABLE_MCP_IMAGE=ghcr.io/pouzor/homelable-mcp:3.6.0

# The domain name for the homelable service:
HOMELABLE_TRAEFIK_HOST=homelable.example.com

# Backend network mode: 'bridge' or 'host'.
## bridge (default): the backend stays on the compose network, so none of its
## ports are exposed on the Docker host. Trade-off: MAC addresses come from
## ARP (layer 2), which a container on a bridge network can never see, and
## the passive mDNS sweep receives no LAN multicast.
## host: the backend joins the Docker host's network. MAC scanning and the
## mDNS sweep work, but the backend port (HOMELABLE_BACKEND_PORT) binds
## directly on the Docker host with no isolation — keep it firewalled.
HOMELABLE_NETWORK_MODE=bridge

# Port the backend listens on. In host mode this binds directly on the Docker
# host (pick a free port — another app may already use 8000). In bridge mode
# it is only reachable from the other containers of this project, so
# `make config` only asks for it in host mode (bridge mode uses 8000).
HOMELABLE_BACKEND_PORT=8000

# The name of this instance. If there is only one instance, use 'default'.
HOMELABLE_INSTANCE=
# You can protect this instance from uninstallation by setting this true:
## If true, make this instance immune to: `make uninstall`, `make destroy`
## Still allowed regardless: `make install`, `make stop`, `make start`, `make restart`
HOMELABLE_INSTANCE_PROTECTION=false

# Filter access by IP address source range (CIDR):
##Disallow all access: 0.0.0.0/32
##Allow all access: 0.0.0.0/0
HOMELABLE_IP_SOURCERANGE=0.0.0.0/0

# HTTP Basic Authentication:
# Use `make config` to fill this in properly, or set this to blank to disable.
HOMELABLE_HTTP_AUTH=

# OAUTH2
# Set to `true` to use OpenID/OAuth2 authentication via the
# oauth2-proxy service in d.rymcg.tech.
# Note: Homelable's built-in auth cannot check the user header that
# oauth2-proxy sends, so any account on your OAuth2 provider
# that passes the authorization group would get full access to the app.
HOMELABLE_OAUTH2=false
# In addition to Oauth2 authentication, you can configure basic authorization
# by entering which authorization group can log into your app.
HOMELABLE_OAUTH2_AUTHORIZED_GROUP=

# Mutual TLS (mTLS):
# Set true or false. If true, all clients must present a certificate signed by Step-CA:
HOMELABLE_MTLS_AUTH=false
# Enter a comma separated list of client domains allowed to connect via mTLS.
# Wildcards are allowed and encouraged on a per-app basis:
HOMELABLE_MTLS_AUTHORIZED_CERTS=*.clients.homelable.example.com

# Built-in app authentication (Homelable's single local admin account).
# The password is stored as a bcrypt hash. `make config` generates a random
# password and records it for you; the hash is stored $$-escaped, which is
# required for docker compose interpolation.
HOMELABLE_AUTH_USERNAME=admin
HOMELABLE_AUTH_PASSWORD_HASH=

# Backend session/cookie secret.
# Generate: openssl rand -hex 32
HOMELABLE_SECRET_KEY=

# JSON array of CIDR ranges the backend scans, eg. ["192.168.1.0/24"].
# Intentionally empty by default: the Docker host's LAN differs per context,
# so this is set per-context (`make config` asks; or
# `make reconfigure var=HOMELABLE_SCANNER_RANGES=[...]`). With no ranges the
# app runs but performs no scans until one is added (also possible in-app via
# the "Scan Network" button).
# Note: devices on routed (non-local) VLANs are discovered by IP, but ARP does
# not cross routers, so they never report a MAC address and their identity
# can drift when a DHCP lease changes.
HOMELABLE_SCANNER_RANGES=[]

# How often to check node status (seconds)
HOMELABLE_STATUS_CHECKER_INTERVAL=60

# The URL(s) you use to access Homelable in your browser (JSON array).
# Must include the traefik host or the UI's API calls will fail CORS.
# `make config` sets this to the traefik host while it holds a single
# origin; once you list more than one, it is left as you wrote it.
HOMELABLE_CORS_ORIGINS=["https://homelable.example.com"]

# Optional MCP server (AI integration). `make config` sets the compose
# profiles from this (adds 'mcp' when true):
HOMELABLE_MCP_ENABLED=false
# Docker compose profiles ('mcp' runs the MCP server):
HOMELABLE_DOCKER_COMPOSE_PROFILES=default
# Host port for the MCP server (the container itself always listens on 8001).
# It is published on the Docker host, so pick a free port.
HOMELABLE_MCP_PORT=8001
# MCP server keys (generate: openssl rand -hex 32).
# Required before enabling the 'mcp' profile.
HOMELABLE_MCP_API_KEY=
HOMELABLE_MCP_SERVICE_KEY=

## Labels to configure Homepage
## See https://github.com/EnigmaCurry/d.rymcg.tech/tree/master/homepage#homepage
HOMELABLE_HOMEPAGE_LABELS_ENABLE=true
HOMELABLE_HOMEPAGE_GROUP_HOMELABLE=Network
HOMELABLE_HOMEPAGE_NAME_HOMELABLE=Homelable
# Choose a service icon from any of these services:
## https://dashboardicons.com/                 :: no prefix needed
## https://pictogrammers.com/library/mdi/      :: prefix with mdi-*
## https://simpleicons.org/                    :: prefix with si-*
## https://selfh.st/icons/                     :: prefix with sh-*
## (check dashboardicons.com for a 'homelable' icon; fall back to mdi-lan)
HOMELABLE_HOMEPAGE_ICON_HOMELABLE=mdi-lan
## If description is blank, it will default to the the traefik_host:
HOMELABLE_HOMEPAGE_DESCRIPTION_HOMELABLE=
## Display container stats widget:
HOMELABLE_HOMEPAGE_SHOW_STATS_HOMELABLE=false
## gethomepage widget: Homelable exposes read-only stats at
## /api/v1/stats/summary, gated by the same key passed to the backend as
## HOMEPAGE_API_KEY (this variable). The widget label sends it as an
## X-API-Key header on the public traefik host, which applies all of this
## app's Traefik middlewares. So the widget only works with HTTP Basic
## Auth, OAuth2 and mTLS all disabled, and with HOMELABLE_IP_SOURCERANGE
## allowing the homepage server. It also needs
## HOMELABLE_HOMEPAGE_LABELS_ENABLE=true.
HOMELABLE_HOMEPAGE_WIDGET_ENABLE=false
HOMELABLE_HOMEPAGE_WIDGET_API_KEY=


# META:
# PREFIX=HOMELABLE
